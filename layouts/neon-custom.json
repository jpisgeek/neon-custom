{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "sidebar-head",
          "type": "block",
          "content": {
            "mod": "neon-custom-sidebar",
            "props": {
              "part": "head"
            }
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-nav",
          "type": "block",
          "content": {
            "mod": "neon-custom-sidebar",
            "props": {
              "part": "nav"
            }
          },
          "size": {
            "px": 156
          }
        },
        {
          "id": "sidebar-lists",
          "type": "block",
          "content": {
            "mod": "neon-custom-sidebar",
            "props": {
              "part": "list"
            }
          },
          "size": {
            "weight": 1
          },
          "min": 120
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "neon-custom-sidebar",
            "props": {
              "part": "foot"
            }
          },
          "size": {
            "px": 60
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 460,
      "background": "chrome"
    },
    {
      "id": "work-column",
      "type": "column",
      "children": [
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main-stack",
              "type": "stack",
              "children": [
                {
                  "id": "work",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "neon-custom-pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "#8f39b5"
                      },
                      "focus": {
                        "width": 2,
                        "color": "#ff3bd4"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  },
                  "padding": 10
                },
                {
                  "id": "home",
                  "type": "block",
                  "content": {
                    "mod": "neon-custom-home"
                  },
                  "background": {
                    "image": "mods/neon-custom-home/halftone-pink-green.png",
                    "fit": "cover"
                  }
                }
              ],
              "active": "work",
              "size": {
                "weight": 1
              },
              "min": 0
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files",
                  "size": {
                    "weight": 1
                  },
                  "min": 0
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "background": "canvas",
              "padding": 10
            }
          ],
          "gap": 0
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "neon-custom-status"
          },
          "size": {
            "px": 30
          },
          "border": {
            "width": 1,
            "color": "#ff3bd4"
          }
        }
      ]
    }
  ],
  "background": "canvas",
  "theme": "neon-custom",
  "terminal_padding": [
    16,
    20
  ],
  "divider": {
    "width": 2,
    "color": "#ff3bd4"
  },
  "titlebar": "none",
  "traffic_lights": [
    16,
    15
  ],
  "preview": "layouts/neon-custom.svg"
}
